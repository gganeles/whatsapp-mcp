#!/sbin/openrc-run
# Installed by linux/install.sh as /etc/init.d/whatsapp-mcp-tunnel on OpenRC systems.
name="Cloudflare Tunnel for the WhatsApp MCP server"
command=/usr/local/libexec/whatsapp-mcp/run
command_args=tunnel
command_user=whatsapp-mcp:whatsapp-mcp
supervisor=supervise-daemon
respawn_delay=10
respawn_max=0
output_log=/var/log/whatsapp-mcp/tunnel.log
error_log=/var/log/whatsapp-mcp/tunnel.log

depend() {
	need net
	after whatsapp-mcp
}

start_pre() {
	checkpath -d -m 0750 -o whatsapp-mcp:whatsapp-mcp /var/log/whatsapp-mcp
}
