#!/bin/sh
# Runs whatsapp-mcp commands against the installed server's data, as the service user.
#
#   sudo whatsapp-mcp-admin user add +14155551234
#   sudo whatsapp-mcp-admin user list
#   sudo whatsapp-mcp-admin revoke-tokens
#   sudo whatsapp-mcp-admin healthcheck
#
# Installed by linux/install.sh as /usr/local/sbin/whatsapp-mcp-admin.
set -eu
if [ "$(id -u)" -ne 0 ]; then
	exec sudo "$0" "$@"
fi
set -a
# shellcheck source=/dev/null
. /etc/whatsapp-mcp/env
set +a
export WHATSAPP_MCP_DATA=/var/lib/whatsapp-mcp HOME=/var/lib/whatsapp-mcp
cd /
if command -v runuser >/dev/null 2>&1; then
	exec runuser -u whatsapp-mcp -- /usr/local/bin/whatsapp-mcp "$@"
elif command -v setpriv >/dev/null 2>&1; then
	exec setpriv --reuid=whatsapp-mcp --regid=whatsapp-mcp --init-groups /usr/local/bin/whatsapp-mcp "$@"
else
	exec su-exec whatsapp-mcp:whatsapp-mcp /usr/local/bin/whatsapp-mcp "$@"
fi
