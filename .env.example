# The public HTTPS address of this server, as configured in your Cloudflare Tunnel.
WHATSAPP_MCP_PUBLIC_URL=https://whatsapp.example.com

# Token from Cloudflare Zero Trust > Networks > Tunnels > your tunnel > Docker install command.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: set to true to disable every tool that sends messages.
WHATSAPP_MCP_READ_ONLY=false
